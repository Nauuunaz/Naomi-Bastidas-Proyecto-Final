    <style>
        /* PALETA DE COLORES: Negro absoluto, fondo de tarjetas gris muy oscuro, acentos rosa viejo y vino */
        :root {
            --bg-black: #000000;
            --bg-card: #0a0a0a;
            --rose-pink: #d4a5b8; /* Rosa Viejo */
            --rose-glow: rgba(212, 165, 184, 0.12);
            --burgundy: #4a131e;
            --text-white: #ffffff;
            --text-grey: #b0b0b0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-black);
            color: var(--text-white);
            font-family: 'Urbanist', sans-serif;
            overflow-x: hidden;
            line-height: 1.6;
        }

        /* MENÚ DE NAVEGACIÓN REFINADO */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 25px 8%;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(12px);
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        }

        nav .logo {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            letter-spacing: 2px;
            color: var(--text-white);
        }

        nav .logo span {
            color: var(--rose-pink);
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 35px;
        }

        nav ul li a {
            color: var(--text-grey);
            text-decoration: none;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: color 0.3s ease;
        }

        nav ul li a:hover {
            color: var(--rose-pink);
        }

        /* ESTRUCTURA GENERAL DE LAS SECCIONES */
        section {
            padding: 140px 10% 100px 10%;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
        }

